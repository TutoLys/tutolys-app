    {
      "name": "event_outbox",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"event_outbox\" (\"event_id\" TEXT NOT NULL, \"kid_id\" TEXT NOT NULL, \"payload\" TEXT NOT NULL, \"queued_at\" TEXT NOT NULL, \"attempts\" INTEGER NOT NULL DEFAULT 0, \"next_retry_at\" TEXT NULL, \"delivered_at\" TEXT NULL, \"last_error\" TEXT NULL, PRIMARY KEY (\"event_id\"));"
        }
      ]
    },
    {
      "name": "exercise_cache",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"exercise_cache\" (\"exercise_id\" TEXT NOT NULL, \"version\" INTEGER NOT NULL, \"payload\" TEXT NOT NULL, \"content_hash\" TEXT NOT NULL, \"engine_key\" TEXT NOT NULL, \"skill_node_id\" TEXT NOT NULL, \"subject\" TEXT NOT NULL, \"grade\" INTEGER NOT NULL, \"rank\" INTEGER NOT NULL, \"cached_at\" TEXT NOT NULL, PRIMARY KEY (\"exercise_id\"));"
        }
      ]
    },
    {
      "name": "skill_node_cache",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"skill_node_cache\" (\"id\" TEXT NOT NULL, \"label_fr\" TEXT NOT NULL, \"label_en\" TEXT NOT NULL, \"stable_key\" TEXT NOT NULL, \"subject\" TEXT NOT NULL, \"grade\" INTEGER NOT NULL, PRIMARY KEY (\"id\"));"
        }
      ]
    },
    {
      "name": "engine_settings",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"engine_settings\" (\"kid_id\" TEXT NOT NULL, \"engine_key\" TEXT NOT NULL, \"setting_key\" TEXT NOT NULL, \"value\" TEXT NOT NULL, PRIMARY KEY (\"kid_id\", \"engine_key\", \"setting_key\"));"
        }
      ]
    },
    {
      "name": "app_state",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"app_state\" (\"kid_id\" TEXT NOT NULL, \"key\" TEXT NOT NULL, \"value\" TEXT NOT NULL, \"updated_at\" TEXT NOT NULL, PRIMARY KEY (\"kid_id\", \"key\"));"
        }
      ]
    },
    {
      "name": "played_date",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"played_date\" (\"kid_id\" TEXT NOT NULL, \"date\" TEXT NOT NULL, PRIMARY KEY (\"kid_id\", \"date\"));"
        }
      ]
    },
    {
      "name": "audio_cache",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"audio_cache\" (\"exercise_id\" TEXT NOT NULL, \"ref\" TEXT NOT NULL, \"bytes\" BLOB NOT NULL, \"sha256\" TEXT NOT NULL, \"cached_at\" TEXT NOT NULL, PRIMARY KEY (\"exercise_id\", \"ref\"));"
