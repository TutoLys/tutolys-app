{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://tutolys.ca/schemas/play_event.v2.json",
  "title": "TutoLys play event, version 2",
  "description": "Version 2 of the play event (telemetry ADR 0013). Every v1 field keeps its name and meaning; `attempt` and `exercise_complete` mean exactly what they meant in v1, so aggregates, mastery, XP and streaks read v1 and v2 rows alike. Adds the learning-engine runtime's interaction vocabulary, its ids, partial credit (`evaluation.score`) and assistance. Privacy: payloads carry ids and indexes only. Identity still comes from the JWT.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "event_id",
    "event_ts",
    "session_id",
    "event_type",
    "schema_version",
    "app_version",
    "event_category"
  ],
  "properties": {
    "schema_version": {
      "const": 2,
      "description": "This envelope's version."
    },
    "event_id": {
      "type": "string",
      "format": "uuid",
      "description": "Generated client-side. The idempotency key: re-sending an event with the same id is a no-op, which is what makes the app's outbox safe to retry."
    },
    "event_ts": {
      "type": "string",
      "format": "date-time",
      "description": "Client clock at the moment of the event. Kept as-is for ordering within a run; the server also records its own received_at."
    },
    "session_id": {
      "type": "string",
      "format": "uuid",
      "description": "One app play session."
    },
    "exercise_run_id": {
      "type": [
        "string",
        "null"
      ],
      "format": "uuid",
      "description": "One attempt sequence on one exercise. Null for session-level events."
    },
    "event_type": {
      "type": "string",
      "enum": [
        "session_start",
        "exercise_start",
        "attempt",
        "hint_used",
        "exercise_complete",
        "exercise_abandon",
        "session_end",
        "question_presented",
        "option_selected",
        "option_deselected",
        "pair_connected",
        "pair_disconnected",
        "tile_placed",
        "tile_removed",
        "tile_moved",
        "item_placed",
        "item_removed",
        "time_expired",
        "audio_requested",
        "audio_replayed",
        "session_paused",
        "session_resumed"
      ]
    },
    "exercise_id": {
      "type": [
        "string",
        "null"
      ],
      "format": "uuid"
    },
    "exercise_version": {
      "type": [
        "integer",
        "null"
      ],
      "minimum": 1
    },
    "engine_key": {
      "type": [
        "string",
        "null"
      ],
      "maxLength": 64
    },
    "engine_version": {
      "type": [
        "integer",
        "null"
      ],
      "minimum": 1
    },
    "skill_node_id": {
      "type": [
        "string",
        "null"
      ],
      "format": "uuid",
      "description": "The leaf the exercise is tagged to. This is what makes a play report map onto the ministry curriculum."
    },
    "subject": {
      "type": [
        "string",
        "null"
      ],
      "maxLength": 16
    },
    "grade": {
      "type": [
        "integer",
        "null"
      ],
      "minimum": 1,
      "maximum": 11,
      "description": "1–6 primaire, 7–11 Secondaire 1–5 (backend ADR 0029)."
    },
    "rank": {
      "type": [
        "integer",
        "null"
      ],
      "minimum": 0
    },
    "attempt_index": {
      "type": [
        "integer",
        "null"
      ],
      "minimum": 1,
      "description": "1-based within the run. Present on attempt events."
    },
    "answer_payload": {
      "description": "As v1, attempt only. Ids, indexes and short values: every string is at most 64 characters.",
      "anyOf": [
        {
          "type": "null"
        },
        {
          "$ref": "#/$defs/answer_object"
        }
      ]
    },
    "answer_hash": {
      "type": [
        "string",
        "null"
      ],
      "maxLength": 64,
      "description": "Stable hash of the normalized answer. Lets the rules engine tell 'repeated the same wrong answer' from 'tried different wrong answers' — a different signal about what the kid misunderstands."
    },
    "is_correct": {
      "type": [
        "boolean",
        "null"
      ],
      "description": "Null for non-attempt events."
    },
    "ms_since_run_start": {
      "type": [
        "integer",
        "null"
      ],
      "minimum": 0
    },
    "ms_since_prev_event": {
      "type": [
        "integer",
        "null"
      ],
      "minimum": 0
    },
    "hint_index": {
      "type": [
        "integer",
        "null"
      ],
      "minimum": 1
    },
    "summary": {
      "type": [
        "object",
        "null"
      ],
      "description": "Carried by exercise_complete.",
      "additionalProperties": false,
      "properties": {
        "attempts": {
          "type": "integer",
          "minimum": 0
        },
        "correct": {
          "type": "integer",
          "minimum": 0
        },
        "total_ms": {
          "type": "integer",
          "minimum": 0
        },
        "distinct_wrong_answers": {
          "type": "integer",
          "minimum": 0
        },
        "max_repeat_of_same_wrong_answer": {
          "type": "integer",
          "minimum": 0
        },
        "hints_used": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "app_version": {
      "type": "string",
      "maxLength": 32
    },
    "kid_id": {
      "type": [
        "string",
        "null"
      ],
      "description": "IGNORED. Server-controlled: whatever is sent here is overwritten with the verified JWT claim. Permitted in the payload only so a client that includes it for its own logging is not rejected — it is never read."
    },
    "org_id": {
      "type": [
        "string",
        "null"
      ],
      "description": "IGNORED. Server-controlled, as kid_id."
    },
    "device_id": {
      "type": [
        "string",
        "null"
      ],
      "description": "IGNORED. Server-controlled, as kid_id."
    },
    "event_category": {
      "enum": [
        "learning",
        "interaction",
        "accessibility"
      ],
      "description": "The runtime's durable categories. Diagnostic categories are never sent."
    },
    "activity_session_id": {
      "type": [
        "string",
        "null"
      ],
      "format": "uuid",
      "description": "SessionIds.activitySessionId: one exercise played, survives resume."
    },
    "session_run_id": {
      "type": [
        "string",
        "null"
      ],
      "format": "uuid",
      "description": "One mount of an activity: a new id each time the activity screen opens or resumes the same activity session (platform doc §5.4)."
    },
    "question_instance_id": {
      "type": [
        "string",
        "null"
      ],
      "format": "uuid",
      "description": "SessionIds.questionInstanceId: one question within the activity session."
    },
    "sequence": {
      "type": [
        "integer",
        "null"
      ],
      "minimum": 0,
      "description": "Monotonic per activity_session_id, across questions and resumes (the counter rides in the session snapshot). Orders events the clock cannot."
    },
    "active_elapsed_ms": {
      "type": [
        "integer",
        "null"
      ],
      "minimum": 0,
      "description": "Pause-excluded time since the activity session began."
    },
    "content_hash": {
      "type": [
        "string",
        "null"
      ],
      "maxLength": 128
    },
    "evaluation": {
      "type": [
        "object",
        "null"
      ],
      "description": "The verdict on an attempt. Required on a v2 attempt. `ungraded` is never sent as an attempt.",
      "additionalProperties": false,
      "required": [
        "outcome",
        "score",
        "evaluator"
      ],
      "properties": {
        "outcome": {
          "enum": [
            "correct",
            "partial",
            "incorrect"
          ]
        },
        "score": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "evaluator": {
          "type": "string",
          "maxLength": 64,
          "description": "<engine>.<policy>@<version>"
        },
        "authority": {
          "enum": [
            "local",
            "server"
          ],
          "default": "local"
        },
        "errors": {
          "type": "array",
          "maxItems": 16,
          "description": "Misconception codes with the taxonomy version they were read under (LE-B3). `unclassified` is {code: unclassified, taxonomy_version: 0}.",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "code",
              "taxonomy_version"
            ],
            "properties": {
              "code": {
                "type": "string",
                "maxLength": 96
              },
              "taxonomy_version": {
                "type": "integer",
                "minimum": 0
              }
            }
          }
        },
        "items": {
          "type": "object",
          "maxProperties": 64,
          "propertyNames": {
            "maxLength": 64
          },
          "additionalProperties": {
            "type": "boolean"
          }
        }
      }
    },
    "assistance": {
      "type": [
        "object",
        "null"
      ],
      "description": "Help the child had. Marks evidence as assisted, never as wrong.",
      "additionalProperties": false,
      "properties": {
        "hints": {
          "type": "integer",
          "minimum": 0
        },
        "audio_replays": {
          "type": "integer",
          "minimum": 0
        },
        "read_aloud": {
          "type": "boolean"
        }
      }
    },
    "payload": {
      "type": [
        "object",
        "null"
      ],
      "description": "Interaction and accessibility events only. Ids and indexes, never display text, pointer data, keystrokes or audio.",
      "maxProperties": 8,
      "propertyNames": {
        "pattern": "^[a-z][a-z0-9_]{0,31}$",
        "not": {
          "enum": [
            "label",
            "text",
            "stem",
            "prompt",
            "value",
            "answer",
            "transcript",
            "x",
            "y",
            "dx",
            "dy",
            "keystroke",
            "audio"
          ]
        }
      },
      "additionalProperties": {
        "type": [
          "string",
          "integer",
          "boolean",
          "null"
        ],
        "maxLength": 64
      }
    }
  },
  "allOf": [
    {
      "description": "An attempt must say what was answered and whether it was right.",
      "if": {
        "properties": {
          "event_type": {
            "const": "attempt"
          }
        }
      },
      "then": {
        "required": [
          "exercise_run_id",
          "attempt_index",
          "is_correct",
          "answer_hash",
          "evaluation"
        ],
        "properties": {
          "evaluation": {
            "type": "object"
          }
        },
        "description": "is_correct is the categorical verdict v1 readers use: true exactly when the outcome is correct.",
        "if": {
          "properties": {
            "evaluation": {
              "properties": {
                "outcome": {
                  "const": "correct"
                }
              }
            }
          }
        },
        "then": {
          "properties": {
            "is_correct": {
              "const": true
            }
          }
        },
        "else": {
          "properties": {
            "is_correct": {
              "const": false
            }
          }
        }
      }
    },
    {
      "description": "Exercise-scoped events must identify the exercise and its run.",
      "if": {
        "properties": {
          "event_type": {
            "enum": [
              "exercise_start",
              "attempt",
              "hint_used",
              "exercise_complete",
              "exercise_abandon"
            ]
          }
        }
      },
      "then": {
        "required": [
          "exercise_run_id",
          "exercise_id",
          "skill_node_id"
        ]
      }
    },
    {
      "description": "A completion carries its summary.",
      "if": {
        "properties": {
          "event_type": {
            "const": "exercise_complete"
          }
        }
      },
      "then": {
        "required": [
          "summary"
        ]
      }
    },
    {
      "description": "Only an attempt carries an answer or a verdict.",
      "if": {
        "not": {
          "properties": {
            "event_type": {
              "const": "attempt"
            }
          }
        }
      },
      "then": {
        "properties": {
          "answer_payload": {
            "type": "null"
          },
          "evaluation": {
            "type": "null"
          },
          "is_correct": {
            "type": "null"
          }
        }
      }
    },
    {
      "description": "An in-question event belongs to its run: question_instance_id implies exercise_run_id.",
      "if": {
        "required": [
          "question_instance_id"
        ],
        "properties": {
          "question_instance_id": {
            "type": "string"
          }
        }
      },
      "then": {
        "required": [
          "exercise_run_id"
        ],
        "properties": {
          "exercise_run_id": {
            "type": "string"
          }
        }
      }
    },
    {
      "description": "v1's learning types carry no interaction payload.",
      "if": {
        "properties": {
          "event_type": {
            "enum": [
              "session_start",
              "exercise_start",
              "attempt",
              "hint_used",
              "exercise_complete",
              "exercise_abandon",
              "session_end"
            ]
          }
        }
      },
      "then": {
        "properties": {
          "payload": {
            "type": "null"
          }
        }
      }
    }
  ],
  "$defs": {
    "answer_value": {
      "anyOf": [
        {
          "type": "string",
          "maxLength": 64
        },
        {
          "type": [
            "number",
            "boolean",
            "null"
          ]
        },
        {
          "type": "array",
          "maxItems": 64,
          "items": {
            "$ref": "#/$defs/answer_value"
          }
        },
        {
          "$ref": "#/$defs/answer_object"
        }
      ]
    },
    "answer_object": {
      "type": "object",
      "maxProperties": 64,
      "propertyNames": {
        "maxLength": 64
      },
      "additionalProperties": {
        "$ref": "#/$defs/answer_value"
      }
    }
  }
}
